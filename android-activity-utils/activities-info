_hist_json_get() {
  local \
    _msg=() \
    _hist_encode_opts=()
  if [[ "${_hist_index}" != "" ]]; then
    _msg=(
      "Generating JSON for history item"
      "'${_hist_index}'"
      "of task '${_index}'."
    )
    _msg_info \
      "${_msg[*]}"
    # _hist_encode_opts+=(
    #   --arg
    #     "history-id"
    #       "${_hist_index}"
    # )
    if [[ "${_task_process_name}" != "" ]]; then
      _hist_encode_opts+=(
        --arg
          "processName"
            "${_task_process_name}"
      )
    fi
    if [[ "${_hist_object_id}" != "" ]]; then
      _hist_encode_opts+=(
        --arg
          "object-id"
            "${_hist_object_id}"
      )
    fi
    if [[ "${_task_package_name}" != "" ]]; then
      _hist_encode_opts+=(
        --arg
          "packageName"
            "${_task_package_name}"
      )
    fi
    if [[ "${_task_description_label}" != "" ]]; then
      _hist_encode_opts+=(
        --arg
          "taskDescription"
            "${_task_description_label}"
      )
    fi
    if [[ "${_hist_encode_opts[*]}" != "" ]]; then
      _hist_json="$(
        jq \
          "${_jq_opts[@]}" \
          "${_hist_encode_opts[@]}" \
          '$ARGS.named')"
    else
      _msg=(
        "No activity history item"
        "in queue."
      )
      _msg_info \
        "${_msg[*]}"
    fi
    if [[ "${_hist_json}" != "" ]]; then
      _hist+=(
        "${_hist_json}"
      )
      _msg=(
        "Generated task '${_index}'"
        "history item '${_hist_index}'"
        "JSON:"
      )
      _msg_info \
        "${_msg[*]}"
      if [[ "${quiet}" == "n" ]]; then
        echo \
          "${_hist_json}"
      fi
    elif [[ "${_hist_json}" == "" && \
            "${_hist_encode_opts[*]}" != "" ]]; then
      _msg=(
        "Error generating task"
        "history JSON."
      )
      _msg_error \
        "${_msg[*]}" \
        1
    fi
  else
    _msg=(
      "No history index"
      "'_hist_index' selected,"
      "skipping."
    )
    _msg_info \
      "${_msg[*]}"
  fi
}


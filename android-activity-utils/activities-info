#   still it should come up
#   if the program is run
#   with 'strict mode' on.
_dumpsys_json_encode() {
  local \
    _dumpsys="${1}" \
    _dumpsys_activity_activities=() \
    _id \
    _activities=() \
    _activities_encode_opts=() \
    _activity \
    _activity_check \
    _activity_record_opened \
    _activity_record_unknown_id \
    _activity_word \
    _adjust \
    _app_user \
    _app_user_id \
    _app_user_name \
    _app_op \
    _app_op_word \
    _app_op_visibility \
    _areas_restricted \
    _areas_unrestricted \
    _attrs_opened \
    _base_layer \
    _base_layer_word \
    _client \
    _client_word \
    _display \
    _draw_state \
    _enter_animation_pending \
    _fit_sides \
    _fit_sides_word \
    _fl \
    _fl_word \
    _flag \
    _flags=() \
    _fmt \
    _force_hide_non_system_overlay_window \
    _force_seamlessly_rotate \
    _hist=() \
    _hist_index \
    _hist_json \
    _hist_object_id \
    _line=() \
    _private_flags=() \
    _sub_activities=() \
    _sub_hist=() \
    _sub_hist_index \
    _sub_hist_json \
    _sub_task_description_label \
    _sub_task_id \
    _sub_task_icon \
    _sub_task_icon_filename \
    _sub_task_icon_resource \
    _sub_task_object_id \
    _sub_task_opened \
    _sub_task_package_name \
    _sub_task_primary_color \
    _sub_task_process_name \
    _task_process_name \
    _sub_task_type \
    _task_description_label \
    _task_id \
    _task_object_id \
    _task_opened \
    _task_package_name \
    _task_process_name \
    _task_type \
    _task_string \
    _msg=() \
    _word \
    _word_index \
    _word_index_end
  _jq_opts+=(
    -n
  )
  _is_number='^[0-9]+$'
  _msg=(
    "Encoding dumpsys output"
    "in JSON format."
  )
  _msg_info \
    "${_msg[*]}"
  mapfile \
    -d \
      $'\n' \
    _dumpsys_activity_activities < \
    <(echo \
        "${_dumpsys}")
  _msg=(
    "Dumpsys output is '${#_dumpsys_activity_activities[@]}'"
    "lines long."
  )
  _msg_info \
    "${_msg[*]}"
  _index=-1
  _sub_task_index=-1
  _hist_json=""
  _hist_object_id=""
  _sub_activity_json=""
  _sub_hist_json=""
  _sub_task_description_label=""
  _sub_task_id=""
  _sub_task_object_id=""
  _sub_task_opened=""
  _sub_task_package_name=""
  _sub_task_process_name=""
  _sub_task_type=""
  _task_description_label=""
  _task_package_name=""
  _task_process_name=""
  _window=""
  for _line_string in "${_dumpsys_activity_activities[@]}"; do
    _line_string="${_line_string%$'\n'}"
    _line=(
      ${_line_string/\*/\\*}
    )
    if [[ "${_line_string}" == "ACTIVITY MANAGER ACTIVITIES (dumpsys activity activities)" ]]; then
      true
    elif [[ "${_line_string}" == "Display #"*" (activities from top to bottom):" ]]; then
      _display="${_line[1]#\#}"
      true
    elif [[ "${_line_string}" == "  * Task{"* ]]; then
      _task_opened="true"
      _index_display="$((
        _index + 1))"
      _msg=(
        "Parsing task '${_index_display}' line."
      )
      _msg_info \
        "${_msg[*]}"
      if (( -1 < "${_index}" )); then
        _hist_json_get
        _sub_hist_json_get
        # _sub_activity_json_get
        _activity_json_get
      fi
      _hist_json=""
      _hist=()
      _hist_index=""
      _sub_activities=()
      _sub_activity_json=""
      _sub_hist=()
      _sub_hist_index=""
      _sub_task_description_label=""
      _sub_task_id=""
      _sub_task_object_id=""
      _sub_task_opened="false"
      _sub_task_package_name=""
      _sub_task_primary_color=""
      _sub_task_process_name=""
      _sub_task_type=""
      _task_description_label=""
      _task_package_name=""
      _index="$((
        _index + 1 ))"
      _sub_task_index=-1
      _task_string="${_line_string#  \* Task\{}"
      _task_string="${_task_string%\}}"
      _line=(
        ${_task_string}
      )
      _task_object_id="${_line[0]}"
      _msg=(
        "Got task object id '${_task_object_id}'."
      )
      _msg_info \
        "${_msg[*]}"
      _task_id="${_line[1]#\#}"
      for _word in "${_line[@]:2}"; do
        if [[ "${_word}" == "type="* ]]; then
          _task_type="${_word#type=}"
        else
          _msg=(
            "Unknown param '${_word}'"
            "for Task object."
          )
          if [[ "${_silent_mode}" == "y" ]]; then
            true
          elif [[ "${_strict_mode}" == "y" ]]; then
            _msg_error \
              "${_msg[*]}" \
              1
          elif [[ "${_strict_mode}" == "n" ]]; then
            _msg_warning \
              "${_msg[*]}"
          fi
        fi
      done
      _values_clean
    elif [[ "${_line_string}" == "    * Task{"* ]]; then
      _sub_task_index="$((
        _sub_task_index + 1 ))"
      _sub_task_string="${_line_string#    \* Task\{}"
      _sub_task_string="${_sub_task_string%\}}"
      _line=(
        ${_task_string}
      )
      _sub_task_opened="true"
      _msg=(
        "Parsing sub-task line for task '${_sub_task_index}'."
      )
      _msg_info \
        "${_msg[*]}"
      if [[ "${quiet}" == "n" ]]; then
        echo \
          "${_line_string}"
      fi
      _sub_task_object_id="${_line[0]}"
      _sub_task_id="${_line[1]#\#}"
      for _word in "${_line[@]:2}"; do
        if [[ "${_word}" == "type="* ]]; then
          _sub_task_type="${_word#type=}"
        else
          _msg=(
            "Unknown param '${_word}'"
            "for sub-task object."
          )
          if [[ "${_silent_mode}" == "y" ]]; then
            true
          elif [[ "${_strict_mode}" == "y" ]]; then
            _msg_error \
              "${_msg[*]}" \
              1
          elif [[ "${_strict_mode}" == "n" ]]; then
            _msg_warning \
              "${_msg[*]}"
          fi
        fi
      done
    elif [[ "${_line_string}" == "    * Hist "* ]]; then
      _msg=(
        "Parsing task history line."
      )
      _msg_info \
        "${_msg[*]}"
      _hist_opened="true"
      _hist_index_word="${_line[2]}"
      _msg_info \
        "${_line_string}"
      _hist_index_new="${_hist_index_word#$'#'}"
      _hist_index_new="${_hist_index_new%:}"
      if [[ "${_hist_index}" != "${_hist_index_new}" ]]; then
        _msg=(
          "Old index '${_hist_index}'"
          "new index '${_hist_index_new}'."
        )
        _msg_info \
          "${_msg[*]}"
        _hist_json_get \
          "${_hist_index}"
        _hist_index="${_hist_index_new}"
      fi
      _task_description_label=""
      _hist_object_id="${_line[3]}"
      _hist_object_id="${_hist_object_id#ActivityRecord\{}"
    elif [[ "${_line_string}" == "      * Hist "* ]]; then
      _msg=(
        "Parsing sub-task history line."
      )
      _msg_info \
        "${_msg[*]}"
      _sub_hist_opened="true"
      _sub_hist_index_word="${_line[2]}"
      _sub_hist_index_new="${_sub_hist_index_word#$'#'}"
      _sub_hist_index_new="${_sub_hist_index_new%:}"
      if [[ "${_sub_hist_index}" != "${_sub_hist_index_new}" ]]; then
        _msg=(
          "Old sub-task history item index '${_sub_hist_index}'."
          "New sub-task history item index '${_sub_hist_index_new}'."
        )
        _msg_info \
          "${_msg[*]}"
        # _hist_json_get \
        #   "${_hist_index}"
        _sub_hist_index="${_sub_hist_index_new}"
      fi
      _sub_task_description_label=""
      _sub_task_icon=""
      _sub_task_icon_resource=""
      _sub_task_icon_filename=""
      _sub_task_primary_color=""
    # '    * Hist'
    #   * Task{1ad9a3a #4106 type=standard A=10182:com.b44t.messenger U=0 visible=true visibleRequested=true mode=fullscreen translucent=false sz=2}
    #        packageName=com.android.gallery3d processName=com.android.gallery3d'.
    elif [[ "${_line_string}" == "      packageName="* ]]; then
      _msg=(
        "Parsing activity history item package name."
      )
      _msg_info \
        "${_msg[*]}"
      for _word in "${_line[@]}"; do
        if [[ "${_word}" == "packageName="* ]]; then
          _task_package_name="${_word#packageName=}"
          _msg=(
            "Got task package name"
            "'${_task_package_name}'."
          )
          _msg_info \
            "${_msg[*]}"
        elif [[ "${_word}" == "processName="* ]]; then
          _task_process_name="${_word#processName=}"
        else
          _msg=(
            "Unknown parameter '${_word}'"
            "for package name line."
          )
          if [[ "${_silent_mode}" == "y" ]]; then
            true
          elif [[ "${_strict_mode}" == "y" ]]; then
            _msg_error \
              "${_msg[*]}" \
              1
          elif [[ "${_strict_mode}" == "n" ]]; then
            _msg_warning \
              "${_msg[*]}"
          fi
        fi
      done
    elif [[ "${_line_string}" == "        packageName="* ]]; then
      _msg=(
        "Parsing sub-task history item package name."
      )
      _msg_info \
        "${_msg[*]}"
      for _word in "${_line[@]}"; do
        if [[ "${_word}" == "packageName="* ]]; then
          _sub_task_package_name="${_word#packageName=}"
          _msg=(
            "Got task package name"
            "'${_sub_task_package_name}'."
          )
          _msg_info \
            "${_msg[*]}"
        elif [[ "${_word}" == "processName="* ]]; then
          _sub_task_process_name="${_word#processName=}"
        else
          _msg=(
            "Unknown parameter '${_word}'"
            "for package name line."
          )
          if [[ "${_silent_mode}" == "y" ]]; then
            true
          elif [[ "${_strict_mode}" == "y" ]]; then
            _msg_error \
              "${_msg[*]}" \
              1
          elif [[ "${_strict_mode}" == "n" ]]; then
            _msg_warning \
              "${_msg[*]}"
          fi
        fi
      done
    elif [[ "${_line_string}" == "      taskDescription: "* ]]; then
      _msg=(
        "Parsing history item task description label line."
      )
      _msg_info \
        "${_msg[*]}"
      _msg_info \
        "${_line_string}"
      if [[ "${_hist_opened}" == "false" ]]; then
        _msg=(
          "How is history item field '${_hist_opened}' not opened?"
        )
        _msg_info \
          "${_msg_info[*]}"
      elif [[ "${_hist_opened}" == "true" ]]; then
        for _word in "${_line[@]:1}"; do
          if [[ "${_word}" == "label="* ]]; then
            _task_description_label="${_line_string#      taskDescription: label=\"}"
            if [[ "${_task_description_label}" == *"\"" ]]; then
              _task_description_label="${_task_description_label%\"}"
            else
              _task_description_label="${_task_description_label%\" icon=*}"
            fi
            _msg=(
              "Got task description label"
              "'${_task_description_label}'."
            )
            _msg_info \
              "${_msg[*]}"
            break
          fi
        done
        _line_string="${_line_string#      taskDescription: label=\"${_task_description_label}\" }"
        _line=(
          ${_line_string}
        )
        for _word in "${_line[@]}"; do
          # echo \
          #   "${_word}"
          if [[ "${_word}" == "icon="* ]]; then
            _task_icon="${_word#icon=}"
            _msg=(
              "Got sub-task icon"
              "'${_task_icon}'."
            )
            _msg_info \
              "${_msg[*]}"
          elif [[ "${_word}" == "iconResource="* ]]; then
            _task_icon_resource="${_word#iconResource=}"
          elif [[ "${_word}" == "iconFilename="* ]]; then
            _task_icon_filename="${_word#iconFilename=}"
          elif [[ "${_word}" == "primaryColor="* ]]; then
            _task_primary_color="${_word#primaryColor=}"
          else
            _msg=(
              "Unknown parameter '${_word}'"
              "for task history item object."
            )
            if [[ "${_silent_mode}" == "y" ]]; then
              true
            elif [[ "${_strict_mode}" == "y" ]]; then
              _msg_error \
                "${_msg[*]}" \
                1
            elif [[ "${_strict_mode}" == "n" ]]; then
              _msg_warning \
                "${_msg[*]}"
            fi
          fi
        done
      else
        _msg=(
          "The value of '_hist_opened'"
          "is '${_hist_opened}'."
        )
        _msg_info \
          "${_msg[*]}"
      fi
    elif [[ "${_line_string}" == "        taskDescription: "* ]]; then
      _msg=(
        "Parsing sub-task history item description label line."
      )
      _msg_info \
        "${_msg[*]}"
      _msg_info \
        "Line: '${_line_string}'."
      if [[ "${_sub_hist_opened}" == "false" ]]; then
        _msg=(
          "How is sub-task history item field '${_sub_hist_opened}' not opened?"
        )
        _msg_info \
          "${_msg_info[*]}"
      _description_word_index=1
      elif [[ "${_sub_hist_opened}" == "true" ]]; then
        for _word in "${_line[@]:1}"; do
          if [[ "${_word}" == "label="* ]]; then
            _sub_task_description_label="${_line_string#        taskDescription: label=\"}"
            if [[ "${_sub_task_description_label}" == *"\"" ]]; then
              _sub_task_description_label="${_sub_task_description_label%\"}"
            else
              _sub_task_description_label="${_sub_task_description_label%\" icon=*}"
            fi
            _msg=(
              "Got sub-task description label"
              "'${_sub_task_description_label}'."
            )
            _msg_info \
              "${_msg[*]}"
            break
          fi
        done
        _line_string="${_line_string#        taskDescription: label=\"${_sub_task_description_label}\" }"
        _line=(
          ${_line_string}
        )
        for _word in "${_line[@]}"; do
          # echo \
          #   "${_word}"
          if [[ "${_word}" == "icon="* ]]; then
            _sub_task_icon="${_word#icon=}"
            _msg=(
              "Got sub-task icon"
              "'${_sub_task_icon}'."
            )
            _msg_info \
              "${_msg[*]}"
          elif [[ "${_word}" == "iconResource="* ]]; then
            _sub_task_icon_resource="${_word#iconResource=}"
          elif [[ "${_word}" == "iconFilename="* ]]; then
            _sub_task_icon_filename="${_word#iconFilename=}"
          elif [[ "${_word}" == "primaryColor="* ]]; then
            _sub_task_primary_color="${_word#primaryColor=}"
          else
            _msg=(
              "Unknown parameter '${_word}'"
              "for task history item object."
            )
            if [[ "${_silent_mode}" == "y" ]]; then
              true
            elif [[ "${_strict_mode}" == "y" ]]; then
              _msg_error \
                "${_msg[*]}" \
                1
            elif [[ "${_strict_mode}" == "n" ]]; then
              _msg_warning \
                "${_msg[*]}"
            fi
          fi
        done
      else
        _msg=(
          "The value of '_sub_hist_opened'"
          "is '${_sub_hist_opened}'."
        )
        _msg_info \
          "${_msg[*]}"
      fi
    else
      _msg=(
        "Activity '${_index}',"
      )
      if [[ "${_sub_task_opened}" == "true" ]]; then
        _msg=(
          "sub-activity '${_sub_task_id}',"
        )
      fi
      if [[ "${_hist_index}" != "" ]]; then
        _msg+=(
        "task history '${_hist_index}',"
        )
      fi
      _msg+=(
        "unparsed line '${_line_string}'."
      )
      if [[ "${_silent_mode}" == "y" ]]; then
        true
      elif [[ "${_strict_mode}" == "n" ]]; then
        _msg_warning \
          "${_msg[*]}"
      elif [[ "${_strict_mode}" == "y" ]]; then
        _msg_error \
          "${_msg[*]}" \
          1
      fi
    fi
  done
  _activities_jq_arg="[$(
    IFS=","; \
    echo \
      "${_activities[*]}")]"
  _activities_encode_opts+=(
    --argjson
      "activities"
        "${_activities_jq_arg}"
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts}"
    "${_activities_encode_opts[@]}"
  )
  _msg_info \
    "${_msg[*]}"
  jq \
    "${_jq_opts[@]}" \
    "${_activities_encode_opts[@]}" \
    '$ARGS.named.activities'
}


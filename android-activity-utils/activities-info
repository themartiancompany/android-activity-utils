_insets_json_get() {
  local \
    _insets=() \
    _insets_encode_opts=() \
    _index \
    _index_end \
    _inset \
    _key \
    _msg=()
  insets+=(
    "$@"
  )
  _index_end=$((
    ${#_insets[@]} - 1 ))
  for _index \
    in $(seq \
           0 \
           ${_index_end} ); do
    _inset="${_insets["${_index}"]}"
    if [[ "${_inset}" != "" ]]; then
      if [[ "${_index}" == 0 ]]; then
        _key="left"
      elif [[ "${_index}" == 1 ]]; then
        _key="top"
      elif [[ "${_index}" == 2 ]]; then
        _key="right"
      elif [[ "${_index}" == 3 ]]; then
        _key="bottom"
      fi
      _insets_encode_opts+=(
        --arg
          "${_key}" \
            "${_inset}"
      )
    fi
  done
  _insets_json="$(
    jq \
      "${_jq_opts[@]}" \
      "${_insets_encode_opts[@]}" \
      '$ARGS.named')"
  _msg=(
    "Insets JSON: ${_insets_json}"
  )
  _msg_info \
    "${_msg[*]}"
}


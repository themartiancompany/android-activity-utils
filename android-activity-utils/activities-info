_activity_history_json_get() {
  local \
    _hist_jq_arg \
    _activity_history_encode_opts=()
  _hist_jq_arg="[$(
    IFS=","; \
    echo \
      "${_hist[*]}")]"
  _activity_history_encode_opts+=(
    --argjson
      "history"
        "${_hist_jq_arg}"
  )
  _activity_history_json="$(
    jq \
      "${_jq_opts[@]}" \
      "${_activity_history_encode_opts[@]}" \
      '$ARGS.named.history')"
}

_sub_activity_history_json_get() {

_insets_parse() {
  local \
    _insets_params=() \
    _msg=() \
    _param \
    _left \
    _top \
    _right \
    _bottom
  _top=""
  _left=""
  _right=""
  _bottom=""
  _insets_params+=(
    "$@"
  )
  for _param in "${_insets_params[@]}"; do
    if [[ "${_param}" == "left="* ]]; then
      _left="${_param#left=}"
      _left="${_left%\}}"
    elif [[ "${_param}" == "top="* ]]; then
      _top="${_param#top=}"
      _top="${_top%\}}"
    elif [[ "${_param}" == "right="* ]]; then
      _right="${_param#right=}"
      _right="${_right%\}}"
    elif [[ "${_param}" == "bottom="* ]]; then
      _bottom="${_param#bottom=}"
      _bottom="${_bottom%\}}"
    else
      _msg=(
        "Unknown parameter '${_param}'."
      )
      _msg_error \
        "${_msg[*]}" \
        1
    fi
  done
  if [[ "${_left}" != "" ]]; then
    _insets+=(
      "${_left}"
    )
  fi
  if [[ "${_top}" != "" ]]; then
    _insets+=(
      "${_top}"
    )
  fi
  if [[ "${_right}" != "" ]]; then
    _insets+=(
      "${_right}"
    )
  fi
  if [[ "${_bottom}" != "" ]]; then
    _insets+=(
      "${_bottom}"
    )
  fi
}


_sim_json_get() {
  local \
    _sim=() \
    _forward_navigation \
    _param \
    _sim_adjust \
    _sim_state \
    _sim_encode_opts=() \
    _word \
    _msg=()
  _sim_adjust=""
  _sim_state=""
  _forward_navigation=""
  for _word in "${_sim[@]}"; do
    _param="${_word#\{}"
    _param="${_param%\}}"
    if [[ "${_param}" == "adjust="* ]]; then
      _sim_adjust="${_param#adjust=}"
    elif [[ "${_param}" == "state="* ]]; then
      _sim_state="${_param#state=}"
    elif [[ "${_param}" == "forwardNavigation" ]]; then
      _forward_navigation="true"
    else
      _msg=(
        "Unknown sim parameter"
        "'${_param}'."
      )
      _msg_error \
        "${_msg[*]}" \
        1
    fi
  done
  if [[ "${_sim_adjust}" != "" ]]; then
    _sim_encode_opts+=(
      --arg
        "adjust"
          "${_sim_adjust}"
    )
  fi
  if [[ "${_sim_state}" != "" ]]; then
    _sim_encode_opts+=(
      --arg
        "state"
          "${_sim_state}"
    )
  fi
  if [[ "${_forward_navigation}" != "" ]]; then
    _sim_encode_opts+=(
      --arg
        "forwardNavigation"
          "${_forward_navigation}"
    )
  fi
  if [[ "${_sim_encode_opts[*]}" != "" ]]; then
    _sim_json="$(
     jq \
      "${_jq_opts[@]}" \
      "${_sim_encode_opts[@]}" \
      '$ARGS.named')"
  else
    _msg=(
      "Window has no 'soft input mode'"
      "layout attributes."
    )
    _msg_info \
      "${_msg[*]}"
  fi
}


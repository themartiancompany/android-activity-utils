_insets_parse() {
  local \
    _insets_params=() \
    _msg=() \
    _param \
    _left \
    _top \
    _right \
    _bottom
  _top=""
  _left=""
  _right=""
  _bottom=""
  _insets_params+=(
    "$@"
  )
  for _param in "${_insets_params[@]}"; do
    if [[ "${_param}" == "left="* ]]; then
      _left="${_param#left=}"
      _left="${_left%\}}"
    elif [[ "${_param}" == "top="* ]]; then
      _top="${_param#top=}"
      _top="${_top%\}}"
    elif [[ "${_param}" == "right="* ]]; then
      _right="${_param#right=}"
      _right="${_right%\}}"
    elif [[ "${_param}" == "bottom="* ]]; then
      _bottom="${_param#bottom=}"
      _bottom="${_bottom%\}}"
    else
      _msg=(
        "Unknown parameter '${_param}'."
      )
      _msg_error \
        "${_msg[*]}" \
        1
    fi
  done
  if [[ "${_left}" != "" ]]; then
    _insets+=(
      "${_left}"
    )
  fi
  if [[ "${_top}" != "" ]]; then
    _insets+=(
      "${_top}"
    )
  fi
  if [[ "${_right}" != "" ]]; then
    _insets+=(
      "${_right}"
    )
  fi
  if [[ "${_bottom}" != "" ]]; then
    _insets+=(
      "${_bottom}"
    )
  fi
}

# NOTE:
#   Parsing of the fields
#   using '*_word' variables
#   is hard-coded.
#   Also the program implicitly
#   assumes some properties
#   will always be found
#   on the same line,
#   still it should come up
#   if the program is run
#   with 'strict mode' on.
_dumpsys_json_encode() {
  local \
    _dumpsys="${1}" \
    _dumpsys_activity_activities=() \
    _id \
    _activities=() \
    _activities_encode_opts=() \
    _activity \
    _activity_check \
    _activity_record_opened \
    _activity_record_unknown_id \
    _activity_word \
    _adjust \
    _app_user \
    _app_user_id \
    _app_user_name \
    _app_op \
    _app_op_word \
    _app_op_visibility \
    _areas_restricted \
    _areas_unrestricted \
    _attrs_opened \
    _base_layer \
    _base_layer_word \
    _client \
    _client_word \
    _display \
    _draw_state \
    _enter_animation_pending \
    _fit_sides \
    _fit_sides_word \
    _fl \
    _fl_word \
    _flag \
    _flags=() \
    _fmt \
    _force_hide_non_system_overlay_window \
    _force_seamlessly_rotate \
    _hist=() \
    _hist_index \
    _line=() \
    _private_flags=() \
    _task_description_label \
    _task_id \
    _task_object_id \
    _task_opened \
    _task_type \
    _task_string \
    _msg=() \
    _windows_jq_arg \
    _word \
    _word_index \
    _word_index_end
  _jq_opts+=(
    -n
  )
  _is_number='^[0-9]+$'
  _msg=(
    "Encoding dumpsys output"
    "in JSON format."
  )
  _msg_info \
    "${_msg[*]}"
  mapfile \
    -d \
      $'\n' \
    _dumpsys_activity_activities < \
    <(echo \
        "${_dumpsys}")
  _msg=(
    "Dumpsys output is '${#_dumpsys_activity_activities[@]}'"
    "lines long."
  )
  _msg_info \
    "${_msg[*]}"
  _index=-1
  _window=""
  for _line_string in "${_dumpsys_activity_activities[@]}"; do
    _line_string="${_line_string%$'\n'}"
    _line=(
      ${_line_string/\*/\\*}
    )
    if [[ "${_line_string}" == "ACTIVITY MANAGER ACTIVITIES (dumpsys activity activities)" ]]; then
      true
    elif [[ "${_line_string}" == "Display #"*" (activities from top to bottom):" ]]; then
      _display="${_line[1]#\#}"
      true
    elif [[ "${_line_string}" == "  * Task{"* ]]; then
      _hist=()
      _task_opened="true"
      _task_description_label=""
      _index_display="$((
        _index + 1))"
      _msg=(
        "Parsing task '${_index_display}' line."
      )
      _msg_info \
        "${_msg[*]}"
      if (( -1 < "${_index}" )); then
        _hist_json_get \
          "${_hist_index}"
        _activity_json_get
      fi
      _hist_index=""
      _sub_hist_index=""
      _index="$((
        _index + 1 ))"
      _task_string="${_line_string#  \* Task\{}"
      _task_string="${_task_string%\}}"
      _line=(
        ${_task_string}
      )
      _task_object_id="${_line[0]}"
      _task_id="${_line[1]#\#}"
      for _word in "${_line[@]:2}"; do
        if [[ "${_word}" == "type="* ]]; then
          _task_type="${_word#type=}"
        else
          _msg=(
            "Unknown param '${_word}'"
            "for Task object."
          )
          if [[ "${_strict_mode}" == "y" ]]; then
            _msg_error \
              "${_msg[*]}" \
              1
          elif [[ "${_strict_mode}" == "n" ]]; then
            _msg_warning \
              "${_msg[*]}"
          fi
        fi
      done
      _values_clean
    elif [[ "${_line_string}" == "    * Task{"* ]]; then
      _subtask_opened="true"
      _msg=(
        "Parsing sub-task line for task '${_index_display}'."
      )
      _msg_info \
        "${_msg[*]}"
      echo \
        "${_line_string}"
    elif [[ "${_line_string}" == "    * Hist "* ]]; then
      _msg=(
        "Parsing task history line."
      )
      _msg_info \
        "${_msg[*]}"
      _hist_opened="true"
      _hist_index_word="${_line[2]}"
      echo "${_line_string}"
      echo "${_line[@]}"
      echo "${_line[*]}"
      echo "${_hist_index_word}"
      _hist_index_new="${_hist_index_word#$'#'}"
      _hist_index_new="${_hist_index_new%:}"
      echo "${_hist_index_new}"
      if [[ "${_hist_index}" != "${_hist_index_new}" ]]; then
        _msg=(
          "Old index '${_hist_index}'"
          "new index '${_hist_index_new}'."
        )
        _msg_info \
          "${_msg[*]}"
        # _hist_json_get \
        #   "${_hist_index}"
        _hist_index="${_hist_index_new}"
      fi
      _task_description_label=""
    elif [[ "${_line_string}" == "      * Hist "* ]]; then
      _msg=(
        "Parsing sub-task history line."
      )
      _msg_info \
        "${_msg[*]}"
      _sub_hist_opened="true"
      _sub_hist_index_word="${_line[2]}"
      echo "${_line_string}"
      echo "${_line[@]}"
      echo "${_line[*]}"
      echo "${_sub_hist_index_word}"
      _sub_hist_index_new="${_sub_hist_index_word#$'#'}"
      _sub_hist_index_new="${_sub_hist_index_new%:}"
      echo "${_sub_hist_index_new}"
      if [[ "${_sub_hist_index}" != "${_sub_hist_index_new}" ]]; then
        _msg=(
          "Old sub-task history item index '${_sub_hist_index}'."
          "New sub-task history item index '${_sub_hist_index_new}'."
        )
        _msg_info \
          "${_msg[*]}"
        # _hist_json_get \
        #   "${_hist_index}"
        _sub_hist_index="${_sub_hist_index_new}"
      fi
      _sub_task_description_label=""

    # '    * Hist'
    #   * Task{1ad9a3a #4106 type=standard A=10182:com.b44t.messenger U=0 visible=true visibleRequested=true mode=fullscreen translucent=false sz=2}
    elif [[ "${_line_string}" == "      taskDescription: "* ]]; then
      _msg=(
        "Parsing history item task description label line."
      )
      _msg_info \
        "${_msg[*]}"
      _msg_info \
        "${_line_string}"
      if [[ "${_hist_opened}" == "false" ]]; then
        _msg=(
          "How is history item field '${_hist_opened}' not opened?"
        )
        _msg_info \
          "${_msg_info[*]}"
      elif [[ "${_hist_opened}" == "true" ]]; then
        for _word in "${_line[@]:1}"; do
          if [[ "${_word}" == "label="* ]]; then
            _task_description_label="${_word#label=}"
            _msg=(
              "Got task description label"
              "'${_task_description_label}'."
            )
          else
            _msg=(
              "Unknown parameter '${_word}'"
              "for Task object."
            )
            if [[ "${_strict_mode}" == "y" ]]; then
              _msg_error \
                "${_msg[*]}" \
                1
            elif [[ "${_strict_mode}" == "n" ]]; then
              _msg_warning \
                "${_msg[*]}"
            fi
          fi
        done
      else
        _msg=(
          "The value of '_hist_opened'"
          "is '${_hist_opened}'."
        )
        _msg_info \
          "${_msg[*]}"
      fi
    elif [[ "${_line_string}" == "        taskDescription: "* ]]; then
      _msg=(
        "Parsing sub-task history item description label line."
      )
      _msg_info \
        "${_msg[*]}"
      _msg_info \
        "${_line_string}"
      echo " sub hist opened '${_sub_history_opened}'"
      if [[ "${_sub_hist_opened}" == "false" ]]; then
        _msg=(
          "How is sub-task history item field '${_sub_hist_opened}' not opened?"
        )
        _msg_info \
          "${_msg_info[*]}"
      elif [[ "${_sub_hist_opened}" == "true" ]]; then
        for _word in "${_line[@]:1}"; do
          if [[ "${_word}" == "label="* ]]; then
            _sub_task_description_label="${_word#label=}"
            _msg=(
              "Got sub-task description label"
              "'${_sub_task_description_label}'."
            )
          else
            _msg=(
              "Unknown parameter '${_word}'"
              "for task history item object."
            )
            if [[ "${_strict_mode}" == "y" ]]; then
              _msg_error \
                "${_msg[*]}" \
                1
            elif [[ "${_strict_mode}" == "n" ]]; then
              _msg_warning \
                "${_msg[*]}"
            fi
          fi
        done
      else
        _msg=(
          "The value of '_sub_hist_opened'"
          "is '${_sub_hist_opened}'."
        )
        _msg_info \
          "${_msg[*]}"
      fi
    else
      _msg=(
        "Activity '${_index}',"
        "unparsed line '${_line_string}'."
      )
      if [[ "${_strict_mode}" == "n" ]]; then
        _msg_warning \
          "${_msg[*]}"
      elif [[ "${_strict_mode}" == "y" ]]; then
        _msg_error \
          "${_msg[*]}" \
          1
      fi
    fi
  done
  _activities_jq_arg="[$(
    IFS=","; \
    echo \
      "${_windows[*]}")]"
  _activities_encode_opts+=(
    --argjson
      "activities"
        "${_activities_jq_arg}"
  )
  _msg=(
    "Running jq with options"
    "'${_jq_opts}"
    "${_activities_encode_opts[@]}"
  )
  _msg_info \
    "${_msg[*]}"
  jq \
    "${_jq_opts[@]}" \
    "${_activities_encode_opts[@]}" \
    '$ARGS.named.activities'
}


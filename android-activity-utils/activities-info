_activities_info() {
  local \
    _get_mode="${1}" \
    _output_format="${2}" \
    _strict_mode="${3}"
  "_${_get_mode}_get" \
    "${_output_format}" \
    "${_strict_mode}"
}

_auto_detect_mode() {
  local \
    _os \
    _msg=()
  _os="$(
    uname \
      -o)"
  if [[ "${_os}" == "Android" ]]; then
    _root_requirements
    echo \
      "root"
  elif [[ "${_os}" == "GNU/Linux" ]]; then
    _msg=(
      "Not implemented."
      "Something with 'xdotool'"
      "for X.org environment"
      "and ad-hoc support for"
      "wayland compositors"
      "need to be written"
      "but really this is text"
      "for a cross-platform"
      "window manager, not the"
      "Android one."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
}

_set_overrides() {
  if [[ -v override_color ]]; then
    color="${override_color}"
  elif [[ -z "${color}" ]]; then
    color="n"
  fi
  if [[ -v override_quiet ]]; then
    quiet="${override_quiet}"
  elif [[ -z "${quiet}" ]]; then
    quiet="y"
  fi
  _set_override \
    "get" \
    "date" \
    "$(_get_date_human)"
  _set_override \
    "get" \
    "mode" \
    "$(_auto_detect_mode)"
  _set_override \
    "output" \
    "format" \
    "json"
  _set_override \
    "strict" \
    "mode" \
    "n"
}

# Shows configuration options.
_show_config() {
  _msg_info "${app_name} configuration"
  _msg_info "     Got activity at date:   ${get_date}"
  _msg_info "                Info mode:   ${get_mode}"
  _msg_info "            Output format:   ${output_format}"
  _msg_info "              Strict mode:   ${strict_mode}"
}

# Show help usage, with an exit status.
# $1: exit status number.
_usage() {
  local \
    _usage_text
  IFS='' \
    read \
      -r \
      -d '' \
      _usage_text << \
        ENDUSAGETEXT || true

Returns informations about currently opened windows.

Usage:

  ${app_name}
    [options]

  options:

     -m <mode>      How to obtain windows information.
                    It can be 'root' for obtaining them
                    using 'dumpsys window windows'.
                    Default: ${output_format}
     -o <format>    Output format.
                    It can be 'json' or 'plain'.
                    Default: ${output_format}
     -s             Strict mode. If enabled
                    will stop if finds
                    an unknown field.
                    Default: ${strict_mode}

     -h             This message.
     -c             Enable color output.
     -v             Enable verbose output

ENDUSAGETEXT
  _printf \
    '%s\n' \
    "${_usage_text}"
  exit \
    "${1}"
}

_globals
_global_variables
# shellcheck disable=SC2004
# shellcheck disable=SC2034
while \
  getopts \
    'm:o:scvh?' \
    arg; do
  case \
    "${arg}" in
    m)
      override_get_mode="${OPTARG}" ;;
    o)
      override_output_format="${OPTARG}" ;;
    s)
      override_strict_mode="y" ;;
    c)
      override_color="y" ;;
    v)
      override_quiet="n" ;;
    h|?)
      _set_overrides
      _usage \
        0 ;;
    *)
      _msg=(
        "Invalid argument '${arg}'."
      )
      _msg_error \
        "${_msg[*]}" \
        0
      _set_overrides
      _usage \
        1 ;;
  esac
done
shift \
  $((
    OPTIND - 1 \
  ))
_set_overrides
app_opts=(
  "${get_mode}"
  "${output_format}"
  "${strict_mode}"
)
_show_config
_activities_info \
  "${app_opts[@]}"


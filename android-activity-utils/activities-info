_root_get() {
  local \
    _output_format="${1}" \
    _strict_mode="${2}" \
    _dumpsys \
    _cmd \
    _msg=() \
    _sdk
  _sdk="$(
    sdk-version)"
  _msg=(
    "Detected SDK version '${_sdk}'."
  )
  _msg_info \
    "${_msg[*]}"
  if (( 32 < "${_sdk}" )); then
    _cmd=(
      "/system/bin/dumpsys"
        "activity"
        "activities"
    )
  elif (( "${_sdk}" < 28 )); then
    _cmd=(
      "/system/bin/dumpsys"
        "activity"
        "activities"
    )
  else
    _cmd=(
      "/system/bin/dumpsys"
        "activity"
        "activities"
    )
  fi
  _msg=(
    "Running '${_cmd[*]}'."
  )
  _msg_info \
    "${_msg[*]}"
  _dumpsys="$(
    "${_cmd[@]}" || \
    true)"
  _dumpsys_lines="$(
    echo \
      "${_dumpsys}" |
      wc \
        -l)"
  if (( "${_dumpsys_lines}" == 1 )); then
    if [[ "${_dumpsys}" == "${_permissions_error_start[*]}"* && \
          "${_dumpsys}" == *"${_permissions_error_end[*]}" ]]; then
      _pid_word="${_dumpsys#${_permissions_error_start[*]}}"
      _pid="${_pid_word%, uid=* ${_permissions_error_end[*]}}"
      _uid="${_pid_word#${_pid}, uid=*}"
      _msg=(
        "User with uid '${_uid}'"
        "has no permission to run"
        "'dumpsys'. Consider running"
        "'sudo"
            "pm"
              "grant"
                "com.termux"
                "android.permission.PACKAGE_USAGE_STATS'"
        "to enable the termux terminal application user"
        "to run some 'dumpsys activity activities'"
        "without root permission."
      )
      _msg_info \
        "${_msg[*]}"
      _dumpsys="$(
        su \
          -c \
          "${_cmd[*]}" || \
          true)"
    fi
  fi
  if [[ "${_dumpsys}" == "" ]]; then
    _msg=(
      "Error running '${_cmd[*]}'."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  else
    _msg=(
      "Obtained dumpsys."
    )
    _msg_info \
      "${_msg[*]}"
  fi
  "_dumpsys_${_output_format}_encode" \
    "${_dumpsys}"
}


_activity_json_get() {
  local \
    _msg=() \
    _activity_encode_opts=() \
    _activity_history_json \
    _sub_activity_jq_arg
  _activity_json=""
  _activity_history_json=""
  _activity_encode_opts+=(
    --arg
      "task-id"
        "${_task_id}"
  )
  if [[ "${_task_object_id}" != "" ]]; then
    _activity_encode_opts+=(
      --arg
        "object-id"
          "${_task_object_id}"
    )
    _msg=(
      "Task object ID: '${_task_object_id}'."
    )
    _msg_info \
      "${_msg[*]}"
  else
    _msg=(
      "This field should always be present."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
  if [[ "${_task_type}" != "" ]]; then
    _activity_encode_opts+=(
      --arg
        "task-type"
          "${_task_type}"
    )
  fi
  if (( 0 < "${#_hist[@]}" )); then
    _msg=(
      "Detected activity history"
      "structure, parsing."
    )
    _msg_info \
      "${_msg[*]}"
    _activity_history_json_get
    _activity_encode_opts+=(
      --argjson
        "history"
          "${_activity_history_json}"
    )
  else
    _msg=(
      "No activity history"
      "structure detected."
    )
    _msg_info \
      "${_msg[*]}"
  fi
  if (( 0 < "${#_sub_activities[@]}" )); then
    _msg=(
      "Detected sub-activities"
      "structure, parsing."
    )
    _msg_info \
      "${_msg[*]}"
    _sub_activity_json_get
    _sub_activity_jq_arg="$(
      IFS=","; \
      echo \
        "[${_sub_activities[*]}]")"
    _activity_encode_opts+=(
      --argjson
        "tasks"
          "${_sub_activity_jq_arg}"
    )
  else
    _msg=(
      "No sub-activities"
      "structure detected."
    )
    _msg_info \
      "${_msg[*]}"
  fi
  _activity_json="$(
    jq \
      "${_jq_opts[@]}" \
      "${_activity_encode_opts[@]}" \
      '$ARGS.named'
  )"
  _activities+=(
    "${_activity_json}"
  )
  if [[ "${quiet}" == "n" ]]; then
    _msg=(
      "Generated activity JSON:"
    )
    _msg_info \
      "${_msg[*]}"
    echo \
      "${_activity_json}"
  fi
}


_bin="$(
  dirname \
    "$(command \
         -v \
	 "env")")"
_lib="${_bin}/../lib"
_share="${_bin}/../share"
_crash_bash="${_lib}/libcrash-bash/crash-bash"
_sourced \
  "${_crash_bash}" \
  2>"/dev/null" \
  1>"/dev/null" || \
source \
  "${_crash_bash}"

_root_requirements() {
  local \
    _os
  _os="$(
    uname \
      -o)"
  # _check_cmd \
  #   "awk" \
  #   "gawk"
  _check_cmd \
    "grep"
  if [[ "${_os}" == "Android" ]]; then
    _check_cmd \
      "su" \
      "sudo"
  fi
}

# shellcheck disable=SC2034
_global_variables() {
  get_date=""
  get_mode=""
  output_format=""
  output_fields=()
  color=""
  quiet=""
}

_display_output_plain() {
  local \
    _line=()
  for _field in "${_output_fields[@]}"; do
    if [[ "${_field}" == "activity" ]]; then
      _line+=(
        "${_activity}"
      )
    fi
    if [[ "${_field}" == "object-id" ]]; then
      _line+=(
        "${_object_id}"
      )
    fi
    if [[ "${_field}" == "object-type" ]]; then
      _line+=(
        "${_object_type}"
      )
    fi
    if [[ "${_field}" == "android-user" ]]; then
      _line+=(
        "${_android_user}"
      )
    fi
  done
  echo \
    "${_line[*]}"
}

_display_output_json() {
  local \
    _jq_opts=() \
    _activity_focused_encode_opts=()
  _jq_opts+=(
    -n
  )
  for _field in "${_output_fields[@]}"; do
    if [[ "${_field}" == "activity" ]]; then
      _activity_focused_encode_opts+=(
        --arg
          "activity"
            "${_activity}"
      )
    fi
    if [[ "${_field}" == "object-id" ]]; then
      _activity_focused_encode_opts+=(
        --arg
          "object-id"
            "${_object_id}"
      )
    fi
    if [[ "${_field}" == "object-type" ]]; then
      _activity_focused_encode_opts+=(
        --arg
          "object-type"
            "${_object_type}"
      )
    fi
    if [[ "${_field}" == "android-user" ]]; then
      _activity_focused_encode_opts+=(
        --arg
          "android-user"
            "${_android_user}"
      )
    fi
  done
  jq \
    "${_jq_opts[@]}" \
    "${_activity_focused_encode_opts[@]}" \
    '$ARGS.named'
}

_root_get() {
  local \
    _output_format="${1}" \
    _output_fields=() \
    _cmd=() \
    _line=() \
    _activity \
    _android_user \
    _object_id \
    _object_type \
    _sdk
  shift \
    1
  _output_fields+=(
    "$@"
  )
  _sdk="$(
    sdk-version)"
  if (( 32 < "${_sdk}" )); then
    _cmd=(
      "/system/bin/dumpsys"
        "activity"
        "activities"
    )
  elif (( "${_sdk}" < 28 )); then
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  else
    _cmd=(
      "/system/bin/dumpsys"
        "window"
        "windows"
    )
  fi
  _activities="$(
    su \
      -c \
      "${_cmd[*]}")"
  _current_focus_line="$(
    echo \
      "${_activities}" |
      grep \
        "mCurrentFocus=")"
  _line=(
    ${_current_focus_line}
  )
  if [[ " ${_output_fields[*]} " == *" activity "* || \
        "${_output_fields[*]}" == "all" ]]; then
    _activity="${_line[2]}"
    _activity="${_activity%\}}"
    # _activity="$(
    #   echo \
    #     "${_current_focus_line}" |
    #     awk \
    #       '{print $3}' |
    #       awk \
    #         -F \
    #           '}' \
    #         '{print $1}')"
  fi
  if [[ " ${_output_fields[*]} " == *" object-id "* || 
        " ${_output_fields[*]} " == *" object-type "* || \
        "${_output_fields[*]}" == "all" ]]; then
    _object_id="${_line[0]}"
    _object_type="${_object_id#mCurrentFocus=}"
    _object_type="${_object_type%\{}"
    _object_id="${_object_id#mCurrentFocus=${_object_type}%}"
  fi
  if [[ " ${_output_fields[*]} " == *" android-user "* || \
        "${_output_fields[*]}" == "all" ]]; then
    _android_user="${_line[1]}"
  fi
  "_display_output_${_output_format}"
}

_activity_focused() {
  local \
    _mode="${1}" \
    _output_format="${2}" \
    _output_fields=() \
    _cmd=() \
    _activities
  shift \
    2
  _output_fields+=(
    "$@"
  )
  "_${_mode}_get" \
    "${_output_format}" \
    "${_output_fields[@]}"
}

_auto_detect_mode() {
  local \
    _os \
    _msg=()
  _os="$(
    uname \
      -o)"
  if [[ "${_os}" == "Android" ]]; then
    _root_requirements
    echo \
      "root"
  elif [[ "${_os}" == "GNU/Linux" ]]; then
    _msg=(
      "Not implemented."
      "Something with 'xdotool'"
      "needs to be written."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi
}

_output_fields_auto_detect() {
  local \
    _msg=()
  if [[ "${output_fields[*]}" == "" ]]; then
    if [[ "${output_format}" == "plain" ]]; then
      output_fields=(
        "activity"
      )
    elif [[ "${output_format}" == "json" ]]; then
      output_fields=(
        "all"
      )
    else
      _msg=(
        "Unknown output format"
        "'${output_format}'."
      )
      _msg_error \
        "${_msg[*]}" \
        1
    fi
  fi
}

_set_overrides() {
  if [[ -v override_color ]]; then
    color="${override_color}"
  elif [[ -z "${color}" ]]; then
    color="n"
  fi
  if [[ -v override_quiet ]]; then
    quiet="${override_quiet}"
  elif [[ -z "${quiet}" ]]; then
    quiet="y"
  fi
  _set_override \
    "get" \
    "date" \
    "$(_get_date_human)"
  _set_override \
    "get" \
    "mode" \
    "$(_auto_detect_mode)"
  _set_override \
    "output" \
    "format" \
    "plain"
  _output_fields_auto_detect
}

# Shows configuration options.
_show_config() {
  _msg_info "${app_name} configuration"
  _msg_info "     Got activity at date:   ${get_date}"
  _msg_info "                 Get mode:   ${get_mode}"
  _msg_info "            Output format:   ${output_format}"
  _msg_info "            Output fields:   ${output_fields[*]}"
}

# Show help usage, with an exit status.
# $1: exit status number.
_usage() {
  local \
    _exit_code="${1}" \
    _usage_text
  IFS='' \
    read \
      -r \
      -d '' \
      _usage_text << \
        ENDUSAGETEXT || true

Get information about the currently focused Android activity.

Usage:

  ${app_name}
    [options]

  options:

     -m <method>

       Method to obtain activity name.
       It can be 'root'.
       Default: ${get_mode}

     -o <output-format>

       It can be 'plain' or 'json'.
       When selecting output format 'plain',
       be aware available fields are different
       from the ones available for the 'json'
       output format.
       Default: ${output_format}

     -f <output-field>

       For output format 'plain', it can be:
       - activity,
       - android-user,
       - all,
       - object-id,
       - object-type.
       For output format 'json' it can only
       be 'all'.
       Default: ${output_fields[*]}

     -h

       This message.

     -c

       Enable color output.

     -v

       Enable verbose output.

ENDUSAGETEXT
  _printf \
    '%s\n' \
    "${_usage_text}"
  exit \
    "${_exit_code}"
}

_globals
_global_variables
# shellcheck disable=SC2004
# shellcheck disable=SC2034
while \
  getopts \
    'm:a:o:f:cvh?' \
    arg; do
  case \
    "${arg}" in
    m)
      override_get_mode="${OPTARG}" ;;
    a)
      override_sdk_version="${OPTARG}" ;;
    o)
      override_output_format="${OPTARG}" ;;
    f)
      output_fields+=(
        "${OPTARG}"
      ) ;;
    c)
      override_color="y" ;;
    v)
      override_quiet="n" ;;
    h|?)
      _set_overrides
      _usage \
        0 ;;
    *)
      _msg=(
        "Invalid argument '${arg}'."
      )
      _msg_error \
        "${_msg[*]}" \
        0
      _set_overrides
      _usage \
        1 ;;
  esac
done
shift \
  $((
    OPTIND - 1 ))
_set_overrides
app_opts=(
  "${get_mode}"
  "${output_format}"
  "${output_fields[@]}"
)
_show_config
_activity_focused \
  "${app_opts[@]}"

